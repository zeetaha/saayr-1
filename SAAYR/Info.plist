<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>

	<!-- Background execution -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>

	<!-- Required when UIBackgroundModes contains "processing" -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.saayr.app.steps.sync</string>
	</array>

	<!-- HealthKit purpose strings (required by App Store even if only reading) -->
	<key>NSHealthShareUsageDescription</key>
	<string>SAAYR reads your step count from HealthKit to validate activity-based challenges and ensure fair battle completion.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>SAAYR does not write health data. This string is required by Apple when the HealthKit entitlement is present.</string>

	<!-- Motion / CMPedometer -->
	<key>NSMotionUsageDescription</key>
	<string>SAAYR uses motion data to count your steps accurately in real time during activity.</string>

	<!-- Mapbox Access Token (https://account.mapbox.com/access-tokens/) -->
	<key>MBXAccessToken</key>
	<string>$(MAPBOX_ACCESS_TOKEN)</string>
</dict>
</plist>
